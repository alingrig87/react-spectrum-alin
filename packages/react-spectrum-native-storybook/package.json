{
  "name": "react-spectrum-native-storybook",
  "version": "0.1.0",
  "private": true,
  "description": "On-device Storybook (Expo) for @react-spectrum/native — view Button, Checkbox and TextField stories on a simulator/device.",
  "main": "index.ts",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/adobe/react-spectrum"
  },
  "scripts": {
    "storybook-generate": "sb-rn-get-stories -c ./.storybook",
    "start": "yarn storybook-generate && expo start",
    "android": "yarn storybook-generate && expo start --android",
    "ios": "yarn storybook-generate && expo start --ios",
    "web": "yarn storybook-generate && expo start --web",
    "clean": "rm -rf .expo dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-spectrum/native": "0.1.0",
    "expo": "~51.0.0",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "@babel/core": "^7.20.5",
    "@storybook/addon-ondevice-actions": "^7.6.20",
    "@storybook/addon-ondevice-controls": "^7.6.20",
    "@storybook/react-native": "^7.6.20",
    "@types/react": "~18.2.79",
    "babel-preset-expo": "~11.0.0",
    "typescript": "^5.4.5"
  }
}
